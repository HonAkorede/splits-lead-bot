# === Required ===
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# === Data Sources (add as available) ===
# Twitter/X — use Apify actor or Twitter API v2
APIFY_API_TOKEN=
# Farcaster — Neynar API
NEYNAR_API_KEY=
# LunarCrush
LUNARCRUSH_API_KEY=
# Etherscan (for onchain signals)
ETHERSCAN_API_KEY=

# === Schedule ===
# Cron expression for daily run (default: 9am UTC)
CRON_SCHEDULE=0 9 * * *
